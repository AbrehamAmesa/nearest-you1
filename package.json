{
  "name": "nearest-you-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "ensure-deps": "test -x node_modules/.bin/vite || test -x frontend/node_modules/.bin/vite || npm install",
    "predev": "npm run ensure-deps",
    "dev": "npm --workspace=frontend run dev -- --port 3000 --host 0.0.0.0",
    "start": "node frontend/server.mjs",
    "prebuild": "npm run ensure-deps",
    "build": "npm --workspace=frontend run build",
    "prelint": "npm run ensure-deps",
    "lint": "npm --workspace=frontend run lint",
    "clean": "rm -rf frontend/dist"
  }
}
