# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nearestyou
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Required for real Firebase Google Sign-In token verification
# Prefer GOOGLE_APPLICATION_CREDENTIALS pointing to a service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/nearest-you-firebase-adminsdk.json

# Keep false unless you intentionally use the local development-header flow.
ALLOW_DEV_AUTH=false

# Required on server for visual / camera image search (never put in frontend env)
GEMINI_API_KEY=CHANGE_ME

