# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nearestyou
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Required for real Firebase Google Sign-In token verification
# Prefer GOOGLE_APPLICATION_CREDENTIALS pointing to a service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/nearest-you-firebase-adminsdk.json

# Keep false unless you intentionally use the local development-header flow.
ALLOW_DEV_AUTH=false

# Required on server for visual / camera image search (never put in frontend env)
GEMINI_API_KEY=CHANGE_ME

# Public frontend & backend URLs for gateway callbacks (Chapa / Payo)
PUBLIC_APP_BASE_URL=https://nearest-you.vercel.app
PUBLIC_API_BASE_URL=https://nearest-you-backend.onrender.com

# Chapa hosted checkout (use TEST credentials first; live keys only after acceptance testing)
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Payo receipt-based Ethiopian bank transfer (API key required; Payo webhook is authoritative)
PAYO_BASE_URL=https://api.pygate.et/v1
PAYO_API_KEY=

# Enable ONLY for local development demos; never enable in production.
PAYMENTS_ALLOW_SANDBOX_COMPLETION=false
