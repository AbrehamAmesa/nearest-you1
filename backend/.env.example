# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nearestyou
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Required for real Firebase Google Sign-In token verification
# Prefer GOOGLE_APPLICATION_CREDENTIALS pointing to a service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/nearest-you-firebase-adminsdk.json

# Keep false unless you intentionally use the local development-header flow.
ALLOW_DEV_AUTH=false

# Required on server for visual / camera image search (never put in frontend env)
GEMINI_API_KEY=CHANGE_ME

# Public frontend URL for gateway redirect callbacks (Chapa / Payo)
PUBLIC_APP_BASE_URL=http://localhost:3000

# Chapa payment & subaccount split configuration (leave secret empty to use built-in dev sandbox mode)
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Payo direct Ethiopian settlement & webhook verification (leave API key empty to use built-in dev mode)
PAYO_BASE_URL=https://payment.et
PAYO_API_KEY=
PAYO_MERCHANT_ID=
PAYO_WEBHOOK_SECRET=
